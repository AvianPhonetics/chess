(function setupPWA(){
  const SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">' +
    '<rect width="192" height="192" rx="36" fill="#1e2228"/>' +
    '<rect x="24" y="24" width="72" height="72" fill="#eed6b0"/>' +
    '<rect x="96" y="24" width="72" height="72" fill="#a97a55"/>' +
    '<rect x="24" y="96" width="72" height="72" fill="#a97a55"/>' +
    '<rect x="96" y="96" width="72" height="72" fill="#eed6b0"/>' +
    '<text x="96" y="148" font-size="112" text-anchor="middle" ' +
    'font-family="serif" fill="#1e1b18">\u265E</text>' +
    '</svg>';

  const bytes = new TextEncoder().encode(SVG);
  let bin = ""; for (let i=0;i<bytes.length;i++) bin += String.fromCharCode(bytes[i]);
  const iconUrl = "data:image/svg+xml;base64," + btoa(bin);

  const manifest = {
    name: "Шахматы",
    short_name: "Шахматы",
    description: "Лёгкие шахматы офлайн с ИИ и режимом обучения",
    start_url: ".",
    scope: ".",
    display: "standalone",
    orientation: "any",
    background_color: "#14161a",
    theme_color: "#14161a",
    lang: "ru",
    categories: ["games","entertainment"],
    icons: [
      { src: iconUrl, sizes: "192x192", type: "image/svg+xml", purpose: "any" },
      { src: iconUrl, sizes: "512x512", type: "image/svg+xml", purpose: "any" },
      { src: iconUrl, sizes: "any",     type: "image/svg+xml", purpose: "maskable" }
    ]
  };
  try {
    const blob = new Blob([JSON.stringify(manifest)], { type:"application/manifest+json" });
    const url  = URL.createObjectURL(blob);
    const link = document.createElement("link");
    link.rel = "manifest"; link.href = url;
    document.head.appendChild(link);
  } catch(_){}

  const fav = document.createElement("link");
  fav.rel = "icon"; fav.type = "image/svg+xml"; fav.href = iconUrl;
  document.head.appendChild(fav);

  const apple = document.createElement("link");
  apple.rel = "apple-touch-icon"; apple.href = iconUrl;
  document.head.appendChild(apple);

  if ("serviceWorker" in navigator && location.protocol.startsWith("http")){
    navigator.serviceWorker.register("sw.js").catch(() => {});
  }
})();

